{
  "name": "courier-react-quickstart",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A working Courier Inbox in a React + Vite app: server-issued JWT, real-time inbox, one send script.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "concurrently -n server,vite -c blue,green \"npm:dev:server\" \"npm:dev:vite\"",
    "dev:server": "node server.js",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server.js",
    "send": "tsx scripts/send.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trycourier/courier": "^9.3.0",
    "@trycourier/courier-react": "^9.3.0",
    "dotenv": "^16.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  }
}
